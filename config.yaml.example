# HomeMate v3.0 配置文件
# 复制为 config.yaml 后修改

server:
  port: "8080"
  mode: "debug"        # debug / release / test
  log_level: "info"
  timeout:
    read: "10s"
    write: "30s"
    idle: "120s"

database:
  path: "./homemate.db"
  wal_mode: true
  max_open_conns: 10
  max_idle_conns: 5
  conn_max_lifetime: "30m"

jwt:
  secret: "change-this-to-a-random-string-at-least-32-chars"
  expire_in: "24h"
  issuer: "homemate"

wechat:
  app_id: ""
  app_secret: ""
  token: ""

mcp:
  timeout: "30s"
  # servers:
  #   - name: "12306-mcp"
  #     transport: "stdio"
  #     command: "npx"
  #     args: ["-y", "12306-mcp"]
  #     enabled: true
  #   - name: "amap"
  #     transport: "stdio"
  #     command: "npx"
  #     args: ["-y", "@amap/amap-maps-maps"]
  #     enabled: true

openai:
  api_key: ""
  base_url: ""
  model: "gpt-4o"

family:
  name: "My Family"

# Garmin Connect 健康数据同步（v3.9.8）
garmin:
  username: ""          # Garmin 用户名/邮箱（DB data_source_config 未配时兜底）
  password: ""          # Garmin 密码
  token_dir: "./data"   # Go 客户端 token 持久化目录（脚本模式不使用）
  base_url: "https://connect.garmin.com"
  # 脚本同步模式：调度器每 6 小时 exec 调用 Python 脚本拉取并直写 SQLite，
  # 绕过 Go 客户端遇到的 Cloudflare 429。脚本覆盖 health_data_cache 全部 30 字段。
  use_script_sync: true
  sync_script_path: "./scripts/homemate_health_sync.py"
  python_path: "/usr/bin/python3"
  script_timeout: "3m"
  # 中国区由脚本读 GARMIN_IS_CN 环境变量控制（默认中国区 true；海外设 GARMIN_IS_CN=0）