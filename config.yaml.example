# HomeMate v3.0 配置文件
# 复制为 config.yaml 后修改

server:
  port: "8080"
  mode: "debug"        # debug / release / test
  log_level: "info"
  timeout:
    read: "10s"
    write: "30s"
    idle: "120s"

database:
  path: "./homemate.db"
  wal_mode: true
  max_open_conns: 10
  max_idle_conns: 5
  conn_max_lifetime: "30m"

jwt:
  secret: "change-this-to-a-random-string-at-least-32-chars"
  expire_in: "24h"
  issuer: "homemate"

wechat:
  app_id: ""
  app_secret: ""
  token: ""

mcp:
  timeout: "30s"
  # servers:
  #   - name: "12306-mcp"
  #     transport: "stdio"
  #     command: "npx"
  #     args: ["-y", "12306-mcp"]
  #     enabled: true
  #   - name: "amap"
  #     transport: "stdio"
  #     command: "npx"
  #     args: ["-y", "@amap/amap-maps-maps"]
  #     enabled: true

openai:
  api_key: ""
  base_url: ""
  model: "gpt-4o"

family:
  name: "My Family"